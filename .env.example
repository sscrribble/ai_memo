# 로그인 비밀번호 (외부에 공개할 땐 반드시 설정)
MEMO_PASSWORD=change-me
# Claude API 키 (없으면 키워드 규칙으로 분류)
ANTHROPIC_API_KEY=
# 날짜 계산 기준 시간대
MEMO_TZ=Asia/Seoul
# (선택) ntfy 앱으로도 알림 받기. 주소 끝의 주제 이름은 남이 추측하기 어렵게 정하세요.
# 알림 제목·내용이 ntfy 서버를 거쳐 가므로 필요할 때만 켜세요.
# MEMO_NTFY_URL=https://ntfy.sh/내가-정한-긴-이름
# (선택) 웹 푸시 서비스에 알리는 서버 운영자 연락처
# MEMO_CONTACT=mailto:you@example.com
# 분류 모델 (기본값 claude-opus-5-5)
# MEMO_MODEL=claude-opus-5-5
